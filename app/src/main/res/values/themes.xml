<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EvenMonkeyCanRent" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <!-- Тема системного SplashScreen (AndroidX core-splashscreen) -->
    <style name="Theme.EvenMonkeyCanRent.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.EvenMonkeyCanRent</item>
    </style>

    <!-- Тексты -->
    <style name="TextAppearance.EvenMonkeyCanRent.Logo" parent="">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="TextAppearance.EvenMonkeyCanRent.Title" parent="">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EvenMonkeyCanRent.Body" parent="">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <!-- Основная кнопка -->
    <style name="Widget.EvenMonkeyCanRent.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.EvenMonkeyCanRent.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
